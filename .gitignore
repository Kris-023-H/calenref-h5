# 依赖
node_modules/
.pnpm-store/

# 构建产物（由 CI 或本地 npm run build 生成）
dist/
dist-test/
dist-ssr/
dev-dist/
dist-test/
*.local

# 环境变量：只提交 .env.example，真实密钥不入库
.env
.env.*
!.env.example

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.tmp/
coverage/
*.tsbuildinfo

# wrangler 本地缓存（部署凭据与构建元数据，不随仓库走）
.wrangler/

# 设计稿原始文件：含设计工具注入标记（data-page-node-id / inject.js），
# 属设计资产而非源码，且绝不能进入上线产物
.wb-lib/

# 本地工作区元数据
.workbuddy-ai/
