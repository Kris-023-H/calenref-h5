# 运行时配置（均可空，空则走本地默认实现）
# AI 推理端点：配置后 RemoteAiService 生效；未配置时使用 LocalTemplateAiService 离线模板解读
VITE_AI_ENDPOINT=
# Stripe Payment Link 核验 Worker（生产上线项，见 README「上线前部署」）
VITE_STRIPE_VERIFY_URL=
# 兑换码离线 HMAC 密钥（生产应通过构建注入；防不住刻意破解，权益价值低可接受）
VITE_REDEEM_KEY=zeji-redeem-dev-key
# 分享落地页主机（用于生成分享链接）
VITE_SHARE_HOST=
# 站点根地址：canonical / OG / JSON-LD / robots.txt / sitemap.xml 的唯一来源
# 换域名只改这一处，不要在多处硬编码
VITE_SITE_URL=https://zeji.app
# Google Analytics 4 衡量 ID（形如 G-XXXXXXXXXX）。
# 留空则完全不加载 GA4；填写后仍只在用户接受 Cookie 统计后才注入脚本。
VITE_GA4_ID=
